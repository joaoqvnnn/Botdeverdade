# ─── TELEGRAM BOT ───
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BOT_USERNAME=BellamyBot

# ─── ADMIN (somente este ID acessa o Mini App admin) ───
